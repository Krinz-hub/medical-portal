{
  "name": "doctor-visibility-backend",
  "version": "1.0.0",
  "description": "Unified backend for Doctor Appointment Visibility Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node-dev --transpile-only src/seed/seedData.ts",
    "test:concurrency": "ts-node-dev --transpile-only src/tests/doubleBookingTest.ts",
    "test:e2e": "ts-node-dev --transpile-only src/tests/e2eAcceptanceTest.ts",
    "test": "npm run test:concurrency && npm run test:e2e"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.3",
    "mongoose": "^8.9.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.17.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
